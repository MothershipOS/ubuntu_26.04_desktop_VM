xhci-pci: reset crosvm's emulated xHCI on resume

crosvm's xHCI cannot restore its state after a guest system suspend (PSCI
SYSTEM_SUSPEND): set XHCI_RESET_ON_RESUME for it.

--- a/drivers/usb/host/xhci-pci.c
+++ b/drivers/usb/host/xhci-pci.c
@@ -252,6 +252,17 @@
 {
 	struct pci_dev                  *pdev = to_pci_dev(dev);
 
+	/*
+	 * crosvm's emulated xHCI (an FL1400 without subsystem IDs) cannot
+	 * restore its state after a system suspend: the command ring pointer
+	 * write is refused and the controller is declared dead. Reset it on
+	 * resume instead; its devices are enumerated again.
+	 */
+	if (pdev->vendor == PCI_VENDOR_ID_FRESCO_LOGIC &&
+	    pdev->device == PCI_DEVICE_ID_FRESCO_LOGIC_FL1400 &&
+	    !pdev->subsystem_vendor && !pdev->subsystem_device)
+		xhci->quirks |= XHCI_RESET_ON_RESUME;
+
 	/* Look for vendor-specific quirks */
 	if (pdev->vendor == PCI_VENDOR_ID_FRESCO_LOGIC &&
 			(pdev->device == PCI_DEVICE_ID_FRESCO_LOGIC_PDK ||
